    {
        "id": "8a24e33b3a1da44a",
        "type": "function",
        "z": "c858fdd926a60eec",
        "name": "Preparar INSERT SQLite",
        "func": "let p = msg.payload || {};\nlet origen = (p.origen || 'esp32c3').replace(/'/g, \"''\");\nlet faccion = (p.faccion || '').replace(/'/g, \"''\");\nlet confianza = Number(p.confianza || 0);\nlet buzzer = p.buzzer ? 1 : 0;\nlet duracion = Number(p.duracion_ms || 0);\nlet estado = (p.estado_fsm || '').replace(/'/g, \"''\");\nlet timestamp = (p.timestamp || new Date().toISOString()).replace(/'/g, \"''\");\n\nmsg.topic = `INSERT INTO eventos (origen, faccion, confianza, buzzer, duracion_ms, estado_fsm, timestamp) VALUES ('${origen}', '${faccion}', ${confianza}, ${buzzer}, ${duracion}, '${estado}', '${timestamp}')`;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 690,
        "y": 620,
