    {
        "id": "bcd679a9e7fa234a",
        "type": "function",
        "z": "c858fdd926a60eec",
        "name": "Formatear fallback UI",
        "func": "let p = msg.payload || {};\n\nif (p.tipo === 'resumen_fallback') {\n    msg.payload = `📋 Eventos en fallback: ${p.total}`;\n} else if (p.tipo === 'fallback_vacio') {\n    msg.payload = '✅ No hay eventos en fallback';\n} else if (p.tipo === 'evento_fallback') {\n    msg.payload = `#${p.indice} | ${p.faccion} | conf: ${p.confianza} | buzzer: ${p.buzzer} | ${p.timestamp}`;\n} else {\n    msg.payload = JSON.stringify(p);\n}\n\nreturn msg;",
