    {
        "id": "40f0fe5ed025843f",
        "type": "function",
        "z": "c858fdd926a60eec",
        "name": "Armar comando JSON para ESP32",
        "func": "let faccion = String(msg.payload || '').toLowerCase().trim();\n\nlet buzzer = false;\nlet duracion = 1000;\n\nif (faccion === 'cansado' || faccion === 'bostezo') {\n    buzzer = true;\n    duracion = 1200;\n}\n\nmsg.topic = 'driverwatch/comando';\nmsg.payload = {\n    cmd: 'guardar_evento',\n    faccion: faccion,\n    confianza: 0.90,\n    timestamp: new Date().toISOString(),\n    buzzer: buzzer,\n    duracion_ms: duracion\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 140,
