        "type": "function",
        "z": "c858fdd926a60eec",
        "name": "Formatear BD para UI",
        "func": "let rows = msg.payload || [];\n\nif (!Array.isArray(rows) || rows.length === 0) {\n    msg.payload = 'Sin registros en la base de datos';\n    return msg;\n}\n\nlet texto = rows.map(r => {\n    return `#${r.id} | ${r.faccion} | conf:${r.confianza} | buzzer:${r.buzzer} | ${r.estado_fsm} | ${r.timestamp}`;\n}).join('\\n');\n\nmsg.payload = texto;\nreturn msg;",
